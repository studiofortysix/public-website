# Preparation only. No real credentials belong in this file.
# Build variables: Netlify Builds scope. Sitekey is public; never use the secret here.
HUGO_ENQUIRY_ENABLED=false
HUGO_TURNSTILE_SITEKEY=

# Runtime variables: Netlify Functions scope, production context only.
# Keep disabled until the separate receiver and Turnstile setup are configured
# and publication/activation has been separately approved.
ENQUIRY_ENABLED=false
HUBSPOT_PORTAL_ID=242183160
HUBSPOT_FORM_ID=536a1f62-34c4-4738-a34f-41f8fbca6806
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=studio46.co.nz
ENQUIRY_ALLOWED_ORIGINS=https://studio46.co.nz
# Required reviewed API consent object, matching the displayed privacy notice.
# Existing cloned settings contain two subscription types, while the submission
# API legitimateInterest object accepts one. Resolve the enquiry subscription
# mapping explicitly before setting this value. Never infer marketing opt-in.
HUBSPOT_LEGAL_CONSENT_JSON=
